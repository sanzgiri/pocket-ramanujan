---
import katex from 'katex';

interface Props {
  latex: string;
  description: string;
  label?: string;
}

const { latex, description, label = 'Mathematical formula' } = Astro.props;
const rendered = katex.renderToString(latex, { displayMode: true, throwOnError: true, output: 'htmlAndMathml' });
---
<figure class="math-block" aria-label={label}>
  <div class="math-block-inner" set:html={rendered}>
    <span class="sr-only">{description}</span>
  </div>
  <figcaption>{description}</figcaption>
</figure>
